{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "baylang_ai",
	"main": "src/main.py",
	"compatibility_flags": [
		"python_workers"
	],
	"compatibility_date": "2026-10-06",
	"vars": {
		"API_HOST": "example.com"
	},
	"d1_databases": [
		{
			// Замените database_id на идентификатор вашей D1-базы:
			// wrangler d1 create baylang_ai
			"binding": "DB",
			"database_name": "baylang_ai",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	]
}
